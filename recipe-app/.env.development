# Recipe app — development defaults (staging workers). Copy to .env.local to override.

# Recipe save worker (handles /api/recipes/:id and /save)
VITE_API_URL=https://staging-recipe-save-worker.nolanfoster.workers.dev

# Search worker
VITE_SEARCH_DB_URL=https://staging-recipe-search-db.nolanfoster.workers.dev

# Clipper worker
VITE_CLIPPER_API_URL=https://staging-clipper.nolanfoster.workers.dev

# Recipe generation worker
VITE_RECIPE_GENERATION_URL=https://recipe-generation-worker-staging.nolanfoster.workers.dev

# Recipe view worker for shareable pages
VITE_RECIPE_VIEW_URL=https://recipe.seasonedapp.com

# Auth worker
VITE_AUTH_WORKER_URL=https://auth-worker-preview.nolanfoster.workers.dev

# User-owned culinary profile and pantry API.
# Must be the same environment as VITE_AUTH_WORKER_URL above: the auth worker signs
# the JWT with its own JWT_SECRET, and only the matching user-management-worker
# environment can verify it. Crossing environments makes every kitchen profile and
# pantry request fail with "Authentication required".
VITE_USER_MANAGEMENT_URL=https://user-management-worker-preview.nolanfoster.workers.dev
