{
  "name": "recipe-clipper-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker for extracting recipes from URLs using GPT-OSS-20B",
  "main": "src/recipe-clipper.js",
  "type": "module",
  "scripts": {
